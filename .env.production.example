# Production Environment Configuration for SnapLearn
# Copy this to .env.production and update with production values

# Database Configuration
DB_NAME=snaplearn_prod
DB_USER=snaplearn_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_PORT=5432
DB_HOST=postgres

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_PORT=6379

# API Keys (REQUIRED - from your provider accounts)
OPENAI_API_KEY=sk-your-production-api-key
OPENROUTER_API_KEY=sk-or-your-production-api-key
OPENROUTER_VISION_MODEL=google/gemini-flash-2.5

# JWT Configuration (MUST be secure)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_STRONG_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# CORS/Allowed Origins (UPDATE WITH YOUR DOMAIN)
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
CAPTURES_PER_DAY=5
CAPTURES_PER_DAY_PREMIUM=50
PRONUNCIATION_ATTEMPTS_PER_DAY=15
PRONUNCIATION_ATTEMPTS_PER_DAY_PREMIUM=100

# Frontend Settings
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NODE_ENV=production

# PWA Settings
NEXT_PUBLIC_PWA_ENABLED=true

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Timezone
TZ=UTC+7

# Email Configuration (for notifications, optional)
SMTP_HOST=smtp.youremail.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@yourdomain.com

# Sentry/Error Tracking (optional)
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
