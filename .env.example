# Frontend port
FRONTEND_PORT=3000
# Database Configuration
DB_NAME=snaplearn
DB_USER=snaplearn
DB_PASSWORD=snaplearn_dev_password
DB_PORT=5432
DB_HOST=postgres

# Redis Configuration
REDIS_PASSWORD=snaplearn_redis_password
REDIS_PORT=6379

# API Keys (Required)
OPENAI_API_KEY=sk-your-api-key-here
OPENROUTER_API_KEY=sk-or-your-api-key-here
OPENROUTER_VISION_MODEL=google/gemini-flash-2.5

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Application Settings
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# CORS/Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_ENABLED=true
CAPTURES_PER_DAY=5
CAPTURES_PER_DAY_PREMIUM=50
PRONUNCIATION_ATTEMPTS_PER_DAY=15
PRONUNCIATION_ATTEMPTS_PER_DAY_PREMIUM=100

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# PWA Settings
NEXT_PUBLIC_PWA_ENABLED=true

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Timezone
TZ=UTC+7
