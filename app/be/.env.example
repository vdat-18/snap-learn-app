# === Required ===
DATABASE_URL=postgresql+asyncpg://snaplearn:snaplearn_dev_password@localhost:5432/snaplearn
REDIS_URL=redis://:snaplearn_dev_password@localhost:6379/0
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
OPENAI_API_KEY=sk-your-openai-key-here

# === Optional (with defaults) ===
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# ENVIRONMENT=development
# DEBUG=false
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# UPLOAD_DIR=./uploads
# TTS_CACHE_DIR=./tts_cache
# LOG_DIR=./logs

# === Rate Limits ===
# CAPTURES_PER_DAY_FREE=5
# CAPTURES_PER_DAY_PREMIUM=50
# PRONUNCIATIONS_PER_DAY_FREE=15
# PRONUNCIATIONS_PER_DAY_PREMIUM=100
# DAILY_TIME_LIMIT_MINUTES=30

# === JWT ===
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
